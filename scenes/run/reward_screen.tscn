[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/run/reward_screen.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/modifier_card.tscn" id="2_ext"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/menu_background.tscn" id="bg_scene"]

[node name="RewardScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
modifier_card_scene = ExtResource("2_ext")

[node name="Background" parent="." instance=ExtResource("bg_scene")]

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 32

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="TitleLabel" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ResultTitle"
text = "¡Fase superada!"
horizontal_alignment = 1

[node name="SummaryLabel" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "+0 oro · +0 XP"
horizontal_alignment = 1

[node name="OfferCaption" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "Elige un modificador para tu kit"
horizontal_alignment = 1

[node name="Offer" type="HBoxContainer" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Actions" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="RerollButton" type="Button" parent="Margin/Layout/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Cambiar opciones"

[node name="ContinueButton" type="Button" parent="Margin/Layout/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Continuar"

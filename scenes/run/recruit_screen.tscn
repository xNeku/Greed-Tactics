[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/run/recruit_screen.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/hero_card.tscn" id="2_card"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/menu_background.tscn" id="bg_scene"]

[node name="RecruitScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
hero_card_scene = ExtResource("2_card")

[node name="Background" parent="." instance=ExtResource("bg_scene")]

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Layout" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="TitleLabel" type="Label" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Alguien quiere unirse"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Elige un compañero"
horizontal_alignment = 1

[node name="Offer" type="HBoxContainer" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="SkipButton" type="Button" parent="Center/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Seguir sin reclutar"

horizontal_alignment = 0
autowrap_mode = 3

[node name="Actions" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="FightButton" type="Button" parent="Margin/Layout/Actions"]
unique_name_in_owner = true

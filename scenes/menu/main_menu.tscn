[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/menu/main_menu.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/hero_card.tscn" id="2_ext"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/menu_background.tscn" id="bg_scene"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
hero_card_scene = ExtResource("2_ext")

[node name="Background" parent="." instance=ExtResource("bg_scene")]
layout_mode = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 20

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_type_variation = &"ResultTitle"
text = "GREED TACTICS"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Elige a tu protagonista: empiezas solo, reclutas por el camino y, ganes o pierdas, sube de nivel"
horizontal_alignment = 1

[node name="Body" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="HeroesPanel" type="PanelContainer" parent="Margin/Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.6

[node name="Heroes" type="VBoxContainer" parent="Margin/Layout/Body/HeroesPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="HeroesHeader" type="Label" parent="Margin/Layout/Body/HeroesPanel/Heroes"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Protagonista"

[node name="Scroll" type="ScrollContainer" parent="Margin/Layout/Body/HeroesPanel/Heroes"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Classes" type="GridContainer" parent="Margin/Layout/Body/HeroesPanel/Heroes/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10
columns = 4

[node name="DetailPanel" type="PanelContainer" parent="Margin/Layout/Body"]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
size_flags_horizontal = 3

[node name="Detail" type="VBoxContainer" parent="Margin/Layout/Body/DetailPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Head" type="HBoxContainer" parent="Margin/Layout/Body/DetailPanel/Detail"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="BigPortrait" type="TextureRect" parent="Margin/Layout/Body/DetailPanel/Detail/Head"]
unique_name_in_owner = true
texture_filter = 1
custom_minimum_size = Vector2(120, 150)
layout_mode = 2
expand_mode = 1
stretch_mode = 5

[node name="Info" type="VBoxContainer" parent="Margin/Layout/Body/DetailPanel/Detail/Head"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1

[node name="HeroName" type="Label" parent="Margin/Layout/Body/DetailPanel/Detail/Head/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Héroe"

[node name="HeroClass" type="Label" parent="Margin/Layout/Body/DetailPanel/Detail/Head/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Clase"

[node name="LevelRow" type="HBoxContainer" parent="Margin/Layout/Body/DetailPanel/Detail/Head/Info"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Roman" type="Label" parent="Margin/Layout/Body/DetailPanel/Detail/Head/Info/LevelRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"RomanLevel"
theme_override_font_sizes/font_size = 40
text = "I"

[node name="LevelCaption" type="Label" parent="Margin/Layout/Body/DetailPanel/Detail/Head/Info/LevelRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"CaptionLabel"
text = "Nivel"

[node name="XpBar" type="ProgressBar" parent="Margin/Layout/Body/DetailPanel/Detail/Head/Info"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
theme_type_variation = &"XpBar"
value = 30.0
show_percentage = false

[node name="XpLabel" type="Label" parent="Margin/Layout/Body/DetailPanel/Detail/Head/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "0 / 150 XP"

[node name="NextLabel" type="Label" parent="Margin/Layout/Body/DetailPanel/Detail"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"GoldLabel"
text = "Siguiente"
autowrap_mode = 3

[node name="WallLabel" type="Label" parent="Margin/Layout/Body/DetailPanel/Detail"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LockedLabel"
text = "Muro"
autowrap_mode = 3

[node name="UnlockedCaption" type="Label" parent="Margin/Layout/Body/DetailPanel/Detail"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Llevas desbloqueado"

[node name="Unlocked" type="HFlowContainer" parent="Margin/Layout/Body/DetailPanel/Detail"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="Description" type="Label" parent="Margin/Layout/Body/DetailPanel/Detail"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Descripción"
autowrap_mode = 3

[node name="Spacer" type="Control" parent="Margin/Layout/Body/DetailPanel/Detail"]
layout_mode = 2
size_flags_vertical = 3

[node name="SeedEdit" type="LineEdit" parent="Margin/Layout/Body/DetailPanel/Detail"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Semilla (opcional)"
alignment = 1

[node name="NewRunButton" type="Button" parent="Margin/Layout/Body/DetailPanel/Detail"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_type_variation = &"BigButton"
text = "Comenzar run"

[node name="Footer" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="CharactersButton" type="Button" parent="Margin/Layout/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "Personajes y progreso"

[node name="QuickBattleButton" type="Button" parent="Margin/Layout/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "Combate rápido"

[node name="StatsLabel" type="Label" parent="Margin/Layout/Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CaptionLabel"
text = "Estadísticas"
horizontal_alignment = 1

[node name="QuitButton" type="Button" parent="Margin/Layout/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "Salir"

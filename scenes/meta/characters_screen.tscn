[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/meta/characters_screen.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/menu_background.tscn" id="bg_scene"]

[node name="CharactersScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" parent="." instance=ExtResource("bg_scene")]
layout_mode = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 18

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 32
text = "Personajes y progreso"

[node name="GlobalStats" type="Label" parent="Margin/Layout/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"CaptionLabel"
text = "Runs"
horizontal_alignment = 2

[node name="BackButton" type="Button" parent="Margin/Layout/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Volver"

[node name="Body" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 14

[node name="ListPanel" type="PanelContainer" parent="Margin/Layout/Body"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2

[node name="HeroList" type="VBoxContainer" parent="Margin/Layout/Body/ListPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="DetailPanel" type="PanelContainer" parent="Margin/Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Scroll" type="ScrollContainer" parent="Margin/Layout/Body/DetailPanel"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Detail" type="VBoxContainer" parent="Margin/Layout/Body/DetailPanel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Head" type="HBoxContainer" parent="Margin/Layout/Body/DetailPanel/Scroll/Detail"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Portrait" type="TextureRect" parent="Margin/Layout/Body/DetailPanel/Scroll/Detail/Head"]
unique_name_in_owner = true
texture_filter = 1
custom_minimum_size = Vector2(130, 160)
layout_mode = 2
expand_mode = 1
stretch_mode = 5

[node name="Info" type="VBoxContainer" parent="Margin/Layout/Body/DetailPanel/Scroll/Detail/Head"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1

[node name="HeroName" type="Label" parent="Margin/Layout/Body/DetailPanel/Scroll/Detail/Head/Info"]
unique_name_in_owner = true
layout_mode = 2

text = "Héroe"

[node name="HeroClass" type="Label" parent="Margin/Layout/Body/DetailPanel/Scroll/Detail/Head/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Clase"

[node name="LevelRow" type="HBoxContainer" parent="Margin/Layout/Body/DetailPanel/Scroll/Detail/Head/Info"]
layout_mode = 2

[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/hud/components/preview_card.gd" id="1_card"]

[node name="PreviewCard" type="PanelContainer"]
mouse_filter = 2
theme_type_variation = &"PreviewPanel"
script = ExtResource("1_card")

[node name="Lines" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="TitleLabel" type="Label" parent="Lines"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Objetivo • Frente"
horizontal_alignment = 1

[node name="DamageLabel" type="Label" parent="Lines"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Daño: 0"
horizontal_alignment = 1

[node name="ChanceLabel" type="Label" parent="Lines"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Golpe: 100%   Crít: 0%"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="Lines"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Quemado 100%"
horizontal_alignment = 1

[node name="ExtraLabel" type="Label" parent="Lines"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Empuje 1"
horizontal_alignment = 1
